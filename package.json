{
  "name": "goof",
  "version": "1.0.1",
  "description": "A vulnerable todo demo application",
  "homepage": "https://snyk.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Snyk/snyk-todo-list-demo-app/"
  },
  "scripts": {
    "start": "node app.js",
    "build": "browserify -r jquery > public/js/bundle.js",
    "cleanup": "mongo express-todo --eval 'db.todos.remove({});'",
    "snyk-protect": "snyk protect",
    "prepare": "npm run snyk-protect"
  },
  "engines": {
    "node": "6.14.1"
  },
  "dependencies": {
    "@snyk/nodejs-runtime-agent": "^1.47.3",
    "adm-zip": "0.4.11",
    "body-parser": "1.9.0",
    "cfenv": "^1.0.4",
    "consolidate": "0.14.5",
    "cookie-parser": "1.3.3",
    "dustjs-helpers": "1.5.0",
    "dustjs-linkedin": "2.6.0",
    "ejs": "3.1.7",
    "ejs-locals": "1.0.2",
    "errorhandler": "1.4.3",
    "express": "5.0.0",
    "express-fileupload": "1.1.10",
    "file-type": "^16.5.4",
    "humanize-ms": "1.0.1",
    "jquery": "^2.2.4",
    "lodash": "4.17.21",
    "marked": "^4.0.10",
    "method-override": "latest",
    "moment": "2.29.4",
    "mongoose": "^9.0.0",
    "morgan": "latest",
    "ms": "^0.7.1",
    "npmconf": "^2.1.3",
    "optional": "^0.1.3",
    "snyk": "^1.290.2",
    "st": "1.2.2",
    "stream-buffers": "^3.0.1",
    "tap": "^18.0.0"
  },
  "devDependencies": {
    "browserify": "^13.1.1"
  },
  "overrides": {
    "minimatch@<3.0.5": "3.0.5",
    "ejs-locals": {
      "ejs": "$ejs"
    }
  },
  "snyk": true
}
